# Do not commit real values. Copy to .env for local development.

# --- Neon PostgreSQL (existing) ---
DATABASE_URL=                     # direct connection, used for migrations
DATABASE_URL_POOLED=              # pooled connection, used by the app

# --- Better Auth (missing: you must generate/add these) ---
BETTER_AUTH_SECRET=               # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173

# --- Discord OAuth app (missing: create at discord.com/developers/applications) ---
# Redirect URL: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Neon Object Storage / S3 (existing) ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# --- DOKU Direct API (existing + missing) ---
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
# Missing: RSA private key used to sign the SNAP B2B access-token request
# (X-SIGNATURE = SHA256withRSA(privateKey, clientID + "|" + timestamp))
DOKU_PRIVATE_KEY=
# Missing: your DOKU Virtual Account company code / BIN (8 digits),
# used as partnerServiceId when creating virtual accounts
DOKU_PARTNER_SERVICE_ID=
# Optional: override the API base URL (defaults to sandbox/production by DOKU_ENV)
DOKU_BASE_URL=
