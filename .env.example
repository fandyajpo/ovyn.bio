# ─────────────────────────────────────────────────────────────────────────────
# OVYN environment variables — copy this file to .env and fill in the values.
# Do not commit .env. No inline comments after values — comments on their own line only.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Neon PostgreSQL ──────────────────────────────────────────────────────
# From Neon Console → Dashboard → Connection Details.
# Direct connection (unpooled) — used ONLY by drizzle-kit migrations.
DATABASE_URL=
# Pooled connection (pgbouncer) — used by the app at runtime.
DATABASE_URL_POOLED=

# ── 2. Neon Auth (Managed Better Auth) ──────────────────────────────────────
# From Neon Console → Better Auth → Project Info → Auth URL.
# Example: https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Secret for signing the auth proxy's session cookie. Generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Discord OAuth is configured in the Neon Console:
#   Project → Auth → Providers → Discord
#   Redirect URL there: http://localhost:5173/api/auth/callback/discord
#   (use https://ovyn.bio/api/auth/callback/discord in production)

# ── 3. Neon Object Storage (S3-compatible) ──────────────────────────────────
# From Neon Console → Storage → Credentials.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ── 4. DOKU Direct API ──────────────────────────────────────────────────────
# From DOKU Dashboard → Integration → API Keys.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
# RSA private key for signing the SNAP B2B access-token request
# (X-SIGNATURE = SHA256withRSA(privateKey, clientID + "|" + timestamp)).
# One long single line, or use \n escapes for newlines.
DOKU_PRIVATE_KEY=
# Your DOKU Virtual Account company code / BIN (8 digits).
DOKU_PARTNER_SERVICE_ID=
# Leave empty for sandbox. Set to "production" for the live API.
DOKU_ENV=
