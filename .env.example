# ─────────────────────────────────────────────────────────────────────────────
# ovyn environment variables - copy this file to .env and fill in the values.
# Do not commit .env. No inline comments after values - comments on their own line only.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Neon PostgreSQL ──────────────────────────────────────────────────────
# From Neon Console → Dashboard → Connection Details.
# Direct connection (unpooled) - used ONLY by drizzle-kit migrations.
DATABASE_URL=
# Pooled connection (pgbouncer) - used by the app at runtime.
DATABASE_URL_POOLED=

# ── 2. Standalone Better Auth ───────────────────────────────────────────────
# Signing secret for sessions - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The exact origin your app runs on. Local dev: http://localhost:5173
# Production: https://ovyn.bio (set in Vercel too)
BETTER_AUTH_URL=http://localhost:5173

# ── 3. Discord OAuth (from discord.com/developers/applications) ─────────────
# In your Discord app → OAuth2 → Redirects, add BOTH:
#   http://localhost:5173/api/auth/callback/discord   (dev)
#   https://ovyn.bio/api/auth/callback/discord        (production)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── 3a. Google OAuth (from console.cloud.google.com) ─────────────────────────
# Authorized redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   https://ovyn.bio/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 3b. ovyn platform admin ─────────────────────────────────────────────────
# Replace this placeholder with your Discord user ID; separate multiple IDs with commas.
# Find your ID in Discord with Developer Mode → right-click your profile → Copy User ID.
OVYN_ADMIN_DISCORD_IDS=your_discord_user_id_here
# Optional: admin access by account email, for people who sign in with Google.
# Separate multiple addresses with commas.
OVYN_ADMIN_EMAILS=

# ── 4. Neon Object Storage (S3-compatible) ──────────────────────────────────
# From Neon Console → Storage → Credentials.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ── 5. DOKU Direct API ──────────────────────────────────────────────────────
# From DOKU Dashboard → Integration → API Keys.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
# RSA private key for signing the SNAP B2B access-token request
# (X-SIGNATURE = SHA256withRSA(privateKey, clientID + "|" + timestamp)).
# One long single line, or use \n escapes for newlines.
DOKU_PRIVATE_KEY=
# Your DOKU Virtual Account company code / BIN (8 digits).
DOKU_PARTNER_SERVICE_ID=
# Leave empty for sandbox. Set to "production" for the live API.
DOKU_ENV=
