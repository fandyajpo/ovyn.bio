# Do not commit real values. Copy to .env for local development.
# NOTE: no inline comments after values — dotenv treats them as part of the value.

# --- Neon PostgreSQL (existing) ---
# direct connection, used for migrations
DATABASE_URL=
# pooled connection, used by the app
DATABASE_URL_POOLED=

# --- Neon Auth — Managed Better Auth (existing + missing) ---
# Copy your Auth URL from Neon Console → Better Auth → Project Info
NEON_AUTH_BASE_URL=
# cookie secret for the server-side session proxy — openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Discord OAuth credentials are configured in the Neon Console
# (Project → Auth → Providers), not in this app.

# --- Neon Object Storage / S3 (existing) ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# --- DOKU Direct API (existing + missing) ---
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
# RSA private key used to sign the SNAP B2B access-token request
# (X-SIGNATURE = SHA256withRSA(privateKey, clientID + "|" + timestamp))
DOKU_PRIVATE_KEY=
# Your DOKU Virtual Account company code / BIN (8 digits)
DOKU_PARTNER_SERVICE_ID=
# Optional: "production" (default is sandbox) or set DOKU_BASE_URL to override
DOKU_ENV=
DOKU_BASE_URL=
